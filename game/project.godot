; Engine configuration file.
; Pinned to Godot 4.7.2. Current focus: Apple Silicon macOS (Metal).

config_version=5

[application]

config/name="Detour"
config/description="Co-op RV road trip through procedurally generated wilderness."
run/main_scene="res://src/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
config/version="0.1.0"
; Release builds would otherwise buffer prints: keep logs complete for bug reports.
run/flush_stdout_on_print=true

[autoload]

Graphics="*res://src/autoload/graphics.gd"
Controls="*res://src/autoload/controls.gd"
Updater="*res://src/autoload/updater.gd"
Session="*res://src/autoload/session.gd"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/dpi/allow_hidpi=true

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
; Render between physics ticks so the RV moves smoothly on 120 Hz displays.
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
; Apple GPUs are tile-based: the Mobile renderer measured ~2x faster than Forward+ at
; 2560x1600 with the same look (docs/perf.md).
renderer/rendering_method.macos="mobile"
rendering_device/driver.macos="metal"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
